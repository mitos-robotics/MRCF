# ── Project: each rig's own files (rig_state.py) ─────────────────────────────
# rig/<backend>/: the overhead camera's calibration (tools/tag_tour.py
# --calibrate), the empty surface's photo, the URDF and its meshes
# (fetch_urdf.py), and what the backend's tools save to fit again. Never
# tracked: another rig's would silently override the values its owner measured.
rig/

# ── Project: generated output ─────────────────────────────────────────────────
# All regenerated by re-running the script that writes them.
reports/

# frames the framework's tools save next to themselves (check_camera.py,
# check_tags.py, calibrate_overhead_camera.py, ...)
tools/*.png
# labelled board + square->robot-frame map, from the last board scan
deployments/chess/board_overlay.png
deployments/chess/board_squares.json
deployments/chess/board_corners.npy
# frame saved when a live board scan fails to find the lattice
deployments/chess/board_debug.png
# what every scan measured and every pick did (board_log.py)
deployments/chess/board_state.json
# who each piece is across scans and restarts (object_memory.py), and copies of it
deployments/chess/object_memory.json
deployments/chess/object_memory.json.bak*
deployments/chess/logs/

# ── Project: personal notes, not for release ──────────────────────────────────
reference/
deployments/chess/tests/piece_frames/
deployments/chess/tests/eval_failures.png

# What the flight recorder keeps (flight_recorder.py): runs/flight/<time>/
runs/

# Models fetched for this computer (tools/fetch_face_model.py: the face model privacy.py covers faces with)
models/
